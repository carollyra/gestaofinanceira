# Server
NODE_ENV=development
PORT=3333
CORS_ORIGIN=http://localhost:5173
# Timezone used to define "today" and the current month
APP_TIMEZONE=America/Sao_Paulo
# Interval of the recurring transactions job, in minutes (0 disables)
RECURRING_JOB_INTERVAL_MINUTES=60

# Database (PostgreSQL / Neon)
# Pooled connection, used by the application at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"
# Direct (non-pooled) connection, used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Separate database used only by integration tests (npm run test:integration).
# Its tables are truncated on every run: never point it to real data.
DATABASE_URL_TEST="postgresql://USER:PASSWORD@HOST/finance_test?sslmode=verify-full"

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-with-at-least-32-chars
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10
